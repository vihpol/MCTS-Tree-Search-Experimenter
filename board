def get_positive_int(prompt, default=None):

    while True:

        value = input(prompt).strip()


        if value == "" and default is not None:

            return default


        try:

            value = int(value)

            if value > 0:

                return value

        except ValueError:

            pass


        print("Enter a positive integer.")



def get_float(prompt, default=None):

    while True:

        value = input(prompt).strip()


        if value == "" and default is not None:

            return default


        try:

            return float(value)

        except ValueError:

            print("Enter a number.")



