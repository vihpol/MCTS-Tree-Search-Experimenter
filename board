def save_config_to_yaml(experiments, filename="compose.generated.yaml"):

    services = {}


    for i, experiment in enumerate(experiments, start=1):


        service_name = f"experiment_{i}"


        services[service_name] = {

            "build": ".",

            "image": "mcts-experiment:latest",

            "pull_policy": "never",


            "command": [

                "--games", str(experiment["games"]),


                "--x_type", experiment["x_type"],

                "--xsimulations", str(experiment["x_simulations"]),

                "--xc", str(experiment["x_c"]),


                "--o_type", experiment["o_type"],

                "--osimulations", str(experiment["o_simulations"]),

                "--oc", str(experiment["o_c"]),


                "--output", f"experiment_{i}.csv"
            ],


            "volumes": [

                "./results:/app/results"
            ]
        }


    compose = {

        "services": services
    }


    with open(filename, "w") as file:

        yaml.safe_dump(compose, file, sort_keys=False)



def run_experiments(filename="compose.generated.yaml"):

    subprocess.run(

        [
            "docker",
            "compose",
            "-f",
            filename,
            "up",
            "--build"
        ],

        check=True
    )



# NEW:
# combines experiment_1.csv, experiment_2.csv, ...
# into one batch_results.csv

def combine_experiment_csvs(experiments, output_file="results/batch_results.csv"):

    rows = []


    for i in range(1, len(experiments) + 1):

        filename = f"results/experiment_{i}.csv"


        if os.path.exists(filename):

            with open(filename, "r", newline="") as file:

                reader = csv.DictReader(file)


                for row in reader:

                    rows.append(row)


    if len(rows) == 0:

        print("No experiment results found.")

        return False


    with open(output_file, "w", newline="") as file:

        writer = csv.DictWriter(
            file,
            fieldnames=rows[0].keys()
        )


        writer.writeheader()

        writer.writerows(rows)


    print(f"Combined results saved to {output_file}")


    return True



# NEW:
# deletes experiment_1.csv, experiment_2.csv, etc.
# AFTER they have been merged

def delete_experiment_csvs(experiments):

    for i in range(1, len(experiments) + 1):

        filename = f"results/experiment_{i}.csv"


        if os.path.exists(filename):

            os.remove(filename)



